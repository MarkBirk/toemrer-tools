# ─── Frontend (miljøvariabler med VITE_ prefix) ──────
# Admin-adgang styres nu af bruger-rollen (role='admin') — ingen frontend-kode.

# API URL (tom = same origin, sæt til backend URL hvis separat)
VITE_API_URL=

# ─── Backend / E-mail server ─────────────────────────
SMTP_HOST=smtpout.secureserver.net
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=din@email.dk
SMTP_PASS=dit-password
MAIL_FROM=din@email.dk

# ─── Database (MySQL på Simply.com) ──────────────────
DB_HOST=mysql.simply.com
DB_USER=dit_brugernavn
DB_PASS=dit_password
DB_NAME=dit_dbnavn

# JWT secret til bruger-auth (PÅKRÆVET i produktion — server starter ikke uden)
JWT_SECRET=en-lang-random-string-mindst-32-tegn

# CORS: komma-separeret liste af tilladte origins i produktion
# (tom = tillad alle; sæt til dit domæne, fx https://toemrer-tools.netlify.app)
ALLOWED_ORIGINS=

# Server port
PORT=3001
